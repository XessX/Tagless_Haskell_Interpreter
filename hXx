-- Core typeclass definitions
class Lambda rep where
  lam :: (rep a -> rep b) -> rep (a -> b)
  app :: rep (a -> b) -> rep a -> rep b

class IntOps rep where
  int :: Int -> rep Int
  neg :: rep Int -> rep Int
  add :: rep Int -> rep Int -> rep Int
  mult :: rep Int -> rep Int -> rep Int
  lt :: rep Int -> rep Int -> rep Bool -- Less than operation
  eq :: rep Int -> rep Int -> rep Bool -- Equality operation


class BoolOps rep where
  bool :: Bool -> rep Bool
  notB :: rep Bool -> rep Bool
  andB :: rep Bool -> rep Bool -> rep Bool
  orB :: rep Bool -> rep Bool -> rep Bool

class IfThenElse rep where
  if_ :: rep Bool -> rep a -> rep a -> rep a

class Fix rep where
    fix :: (a -> a) -> a
    fix f = let x = f x in x
    
class Pairs rep where
    pair :: rep a -> rep b -> rep (a, b)
    fstP :: rep (a, b) -> rep a
    sndP :: rep (a, b) -> rep b

newtype Eval a = Eval { unEval :: a }

instance Lambda Eval where
  lam f = Eval $ \x -> unEval $ f (Eval x)
  app (Eval f) (Eval x) = Eval $ f x

instance IntOps Eval where
  int = Eval
  neg (Eval x) = Eval $ negate x
  add (Eval x) (Eval y) = Eval $ x + y
  mult (Eval x) (Eval y) = Eval $ x * y
  lt (Eval x) (Eval y) = Eval $ x < y
  eq (Eval x) (Eval y) = Eval $ x == y

instance BoolOps Eval where
    bool = Eval
    notB (Eval x) = Eval $ not x
    andB (Eval x) (Eval y) = Eval $ x && y
    orB (Eval x) (Eval y) = Eval $ x || y
  
instance IfThenElse Eval where
    if_ (Eval cond) (Eval thenExpr) (Eval elseExpr) = Eval $ if cond then thenExpr else elseExpr  

instance Pairs Eval where
    pair (Eval x) (Eval y) = Eval (x, y)
    fstP (Eval x) = Eval (fst x)
    sndP (Eval x) = Eval (snd x)

instance Fix Eval where
    fix f = let rec = f (Eval $ unEval rec) in rec    
    
    
newtype Pretty a = Pretty { unPretty :: String }

instance Lambda Pretty where
  lam f = Pretty $ "\\x -> " ++ (unPretty $ f (Pretty "x"))
  app (Pretty f) (Pretty x) = Pretty $ f ++ " " ++ x

instance IntOps Pretty where
    int x = Pretty $ show x
    neg (Pretty x) = Pretty $ "(-" ++ x ++ ")"
    add (Pretty x) (Pretty y) = Pretty $ "(" ++ x ++ " + " ++ y ++ ")"
    mult (Pretty x) (Pretty y) = Pretty $ "(" ++ x ++ " * " ++ y ++ ")"
    lt (Pretty x) (Pretty y) = Pretty $ x ++ " < " ++ y
    eq (Pretty x) (Pretty y) = Pretty $ x ++ " == " ++ y

instance BoolOps Pretty where
    bool b = Pretty $ show b
    notB (Pretty x) = Pretty $ "not (" ++ x ++ ")"
    andB (Pretty x) (Pretty y) = Pretty $ "(" ++ x ++ " && " ++ y ++ ")"
    orB (Pretty x) (Pretty y) = Pretty $ "(" ++ x ++ " || " ++ y ++ ")"
      
instance IfThenElse Pretty where
    if_ (Pretty cond) (Pretty thenExpr) (Pretty elseExpr) = Pretty $ "if " ++ cond ++ " then " ++ thenExpr ++ " else " ++ elseExpr


instance Pairs Pretty where
        pair (Pretty x) (Pretty y) = Pretty $ "(" ++ x ++ ", " ++ y ++ ")"
        fstP (Pretty x) = Pretty $ "fst " ++ x
        sndP (Pretty x) = Pretty $ "snd " ++ x

instance Fix Pretty where
    fix f = Pretty $ "fix " ++ unPretty (f (Pretty "x"))
        
        
        
          
newtype Compile a = Compile { unCompile :: Q Exp }
     
instance IntOps Compile where
    int x = Compile $ [| x |]
    neg (Compile x) = Compile $ [| negate $x |]
    add (Compile x) (Compile y) = Compile $ [| $x + $y |]
    mult (Compile x) (Compile y) = Compile $ [| $x * $y |]
    lt (Compile x) (Compile y) = Compile $ [| $x < $y |]
    eq (Compile x) (Compile y) = Compile $ [| $x == $y |]


instance Lambda Compile where
    lam f = Compile $ [| \x -> $(unCompile $ f (Compile [| x |])) |]
    app (Compile f) (Compile x) = Compile $ [| $f $x |]

instance BoolOps Compile where
    bool b = Compile $ [| b |]
    notB (Compile x) = Compile $ [| not $x |]
    andB (Compile x) (Compile y) = Compile $ [| $x && $y |]
    orB (Compile x) (Compile y) = Compile $ [| $x || $y |]
  
instance IfThenElse Compile where
    if_ (Compile cond) (Compile thenExpr) (Compile elseExpr) = Compile $ [| if $cond then $thenExpr else $elseExpr |]

instance Pairs Compile where
    pair (Compile x) (Compile y) = Compile $ [| ($x, $y) |]
    fstP (Compile x) = Compile $ [| fst $x |]
    sndP (Compile x) = Compile $ [| snd $x |]

instance Fix Compile where
    fix f = Compile $ do
        recName <- newName "rec"
        let recVar = varE recName
            body = unCompile $ f (Compile recVar)
        lamE [varP recName] body
    
    
      
newtype Trace a = Trace { runTrace :: String -> (String, a) }

instance Lambda Trace where
  -- Instead of trying to show `x` directly, we indicate a lambda application.
  lam f = Trace $ \ctx -> ("<lambda>", \x -> let (str, val) = runTrace (f (Trace $ const ("<arg>", x))) "" in val)
  app (Trace f) (Trace x) = Trace $ \ctx -> 
    let (fStr, fVal) = f "applying"
        (xStr, xVal) = x "to"
    in ("(" ++ fStr ++ " " ++ xStr ++ ")", fVal xVal)


instance IntOps Trace where
  int x = Trace $ \_ -> (show x, x)
  neg (Trace x) = Trace $ \ctx -> let (str, val) = x ctx in ("negate (" ++ str ++ ")", negate val)
  add (Trace x) (Trace y) = Trace $ \ctx ->
    let (xStr, xVal) = x ctx
        (yStr, yVal) = y ctx
    in (xStr ++ " + " ++ yStr, xVal + yVal)
  mult (Trace x) (Trace y) = Trace $ \ctx ->
    let (xStr, xVal) = x ctx
        (yStr, yVal) = y ctx
    in (xStr ++ " * " ++ yStr, xVal * yVal)
  lt (Trace x) (Trace y) = Trace $ \ctx ->
    let (xStr, xVal) = x ctx
        (yStr, yVal) = y ctx
    in (xStr ++ " < " ++ yStr, xVal < yVal)
  eq (Trace x) (Trace y) = Trace $ \ctx ->
    let (xStr, xVal) = x ctx
        (yStr, yVal) = y ctx
    in (xStr ++ " == " ++ yStr, xVal == yVal)

instance BoolOps Trace where
  bool b = Trace $ \_ -> (show b, b)
  notB (Trace x) = Trace $ \ctx -> let (str, val) = x ctx in ("not (" ++ str ++ ")", not val)
  andB (Trace x) (Trace y) = Trace $ \ctx ->
    let (xStr, xVal) = x ctx
        (yStr, yVal) = y ctx
    in (xStr ++ " && " ++ yStr, xVal && yVal)
  orB (Trace x) (Trace y) = Trace $ \ctx ->
    let (xStr, xVal) = x ctx
        (yStr, yVal) = y ctx
    in (xStr ++ " || " ++ yStr, xVal || yVal)

instance IfThenElse Trace where
  if_ (Trace cond) (Trace thenExpr) (Trace elseExpr) = Trace $ \ctx ->
    let (condStr, condVal) = cond ctx
        (thenStr, thenVal) = thenExpr ctx
        (elseStr, elseVal) = elseExpr ctx
        resultStr = "if " ++ condStr ++ " then " ++ thenStr ++ " else " ++ elseStr
    in (resultStr, if condVal then thenVal else elseVal)
      

instance Pairs Trace where
    pair (Trace x) (Trace y) = Trace $ \ctx ->
        let (xStr, xVal) = x ctx
            (yStr, yVal) = y ctx
        in ("(" ++ xStr ++ ", " ++ yStr ++ ")", (xVal, yVal))
    fstP (Trace x) = Trace $ \ctx -> let (str, val) = x ctx in ("fst " ++ str, fst val)
    sndP (Trace x) = Trace $ \ctx -> let (str, val) = x ctx in ("snd " ++ str, snd val)


instance Fix Trace where
    fix f = Trace $ \ctx -> ("<fix>", error "Trace: Recursive function evaluation not implemented")
    
factorial :: Eval (Int -> Int)
factorial = fix $ \f n -> if n == 0 then 1 else n * unEval f (n - 1)

factorialPretty :: Pretty (Int -> Int)
factorialPretty = fix $ \f -> lam (\n -> if_ (eq n (int 0)) (int 1) (mult n (app f (add n (neg (int 1))))))

factorialCompile :: Compile (Int -> Int)
factorialCompile = fix $ \f -> lam $ \n -> ifE [| n == 0 |] [| 1 |] [| n * $(app f [| n - 1 |]) |]

    
