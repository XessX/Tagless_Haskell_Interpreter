{-# LANGUAGE TemplateHaskell #-}
{-# LANGUAGE GADTs, TypeFamilies #-}

module Language where

import Language.Haskell.TH
import Language.Haskell.TH (runQ, pprint)
import Data.Text (Text, pack, unpack)
import Test.HUnit

-- Basic expression types
data Expr a where
    -- Booleans and conditional expressions
    BoolE    :: Bool -> Expr Bool
    If       :: Expr Bool -> Expr a -> Expr a -> Expr a

    -- Integer operations
    IntE     :: Int -> Expr Int
    Add      :: Expr Int -> Expr Int -> Expr Int
    Mul      :: Expr Int -> Expr Int -> Expr Int
    Neg      :: Expr Int -> Expr Int
    LessThan :: Expr Int -> Expr Int -> Expr Bool
    Equal    :: Expr Int -> Expr Int -> Expr Bool

    Lambda   :: (Expr a -> Expr b) -> Expr (a -> b)
    Apply    :: Expr (a -> b) -> Expr a -> Expr b
    Fix      :: Expr (a -> a) -> Expr a

    -- Pairs and projections
    Pair     :: Expr a -> Expr b -> Expr (a, b)
    Fst      :: Expr (a, b) -> Expr a
    Snd      :: Expr (a, b) -> Expr b


eval :: Expr a -> a
eval (BoolE b) = b
eval (If cond thenBranch elseBranch) = if eval cond then eval thenBranch else eval elseBranch
eval (IntE i) = i
eval (Add e1 e2) = eval e1 + eval e2
eval (Mul e1 e2) = eval e1 * eval e2
eval (Neg e) = negate $ eval e
eval (LessThan e1 e2) = eval e1 < eval e2
eval (Equal e1 e2) = eval e1 == eval e2
-- Lambda and Apply need a mechanism to handle functions; we'll simplify for this demonstration
-- Pairs and projections are straightforward mappings to Haskell's own constructs
eval (Pair e1 e2) = (eval e1, eval e2)
eval (Fst e) = fst $ eval e
eval (Snd e) = snd $ eval e
-- Simplified and illustrative; in practice, would need an environment or similar construct
eval (Lambda f) = error "Direct lambda evaluation is not supported in this model."
eval (Apply f a) = 
  let func = eval f
      arg = eval a
  in error "Apply not implemented; requires function application support."
eval (Fix f) = error "Fix point evaluation not implemented for simplicity."

lengthOfExpr :: Expr a -> Int
lengthOfExpr (BoolE _) = 1
lengthOfExpr (If cond thenBranch elseBranch) = 1 + lengthOfExpr cond + lengthOfExpr thenBranch + lengthOfExpr elseBranch
lengthOfExpr (IntE _) = 1
lengthOfExpr (Add e1 e2) = 1 + lengthOfExpr e1 + lengthOfExpr e2
lengthOfExpr (Mul e1 e2) = 1 + lengthOfExpr e1 + lengthOfExpr e2
lengthOfExpr (Neg e) = 1 + lengthOfExpr e
lengthOfExpr (LessThan e1 e2) = 1 + lengthOfExpr e1 + lengthOfExpr e2
lengthOfExpr (Equal e1 e2) = 1 + lengthOfExpr e1 + lengthOfExpr e2
lengthOfExpr (Lambda _) = 1 -- Simplification for demonstration
lengthOfExpr (Apply f a) = 1 + lengthOfExpr f + lengthOfExpr a
lengthOfExpr (Fix f) = 1 + lengthOfExpr f

codegen :: Expr a -> Q Exp
codegen (BoolE b) = [| b |]
codegen (If cond thenBranch elseBranch) = 
  [| if $(codegen cond) then $(codegen thenBranch) else $(codegen elseBranch) |]
codegen (IntE i) = [| i |]
codegen (Add e1 e2) = 
  [| $(codegen e1) + $(codegen e2) |]
codegen (Mul e1 e2) = 
  [| $(codegen e1) * $(codegen e2) |]
codegen (Neg e) = 
  [| negate $(codegen e) |]
codegen (Lambda _) = fail "Lambda code generation not implemented."
codegen (Apply f a) = do
  fCode <- codegen f
  aCode <- codegen a
  fail "Apply code generation not implemented; requires function application support."
codegen (Fix _) = fail "Fix code generation not implemented."



prettyPrint :: Expr a -> String
prettyPrint (BoolE b) = show b
prettyPrint (If cond thenBranch elseBranch) = "if " ++ prettyPrint cond ++ " then " ++ prettyPrint thenBranch ++ " else " ++ prettyPrint elseBranch
prettyPrint (IntE i) = show i
prettyPrint (Add e1 e2) = prettyPrint e1 ++ " + " ++ prettyPrint e2
prettyPrint (Mul e1 e2) = prettyPrint e1 ++ " * " ++ prettyPrint e2
prettyPrint (Neg e) = "-" ++ prettyPrint e
-- Placeholder for simplicity; handling more complex structures might require more sophisticated logic
prettyPrint (Lambda _) = "<lambda>"
prettyPrint (Apply f a) = "(" ++ prettyPrint f ++ " applied to " ++ prettyPrint a ++ ")"
prettyPrint (Fix _) = "<fix>"

-- Corrected and Consolidated Test Suite
tests :: Test
tests = TestList [
    TestCase $ assertEqual "eval simple add" 3 (eval (Add (IntE 1) (IntE 2))),
    TestCase $ do code <- runQ $ codegen (Add (IntE 1) (IntE 2))
                  assertEqual "codegen simple add" "1 + 2" (pprint code),
    TestCase $ assertEqual "pretty print simple add" "1 + 2" (prettyPrint (Add (IntE 1) (IntE 2))),
    TestCase $ assertBool "Applying a simple function" $
               let func = Lambda (\x -> Add x (IntE 1))
                   appliedFunc = Apply func (IntE 5)
               in eval appliedFunc == 6,
    TestCase $ assertBool "Fixed-point combinator" $
               let factorial = Fix (Lambda (\f -> Lambda (\x -> If (Equal x (IntE 0))
                                                                  (IntE 1)
                                                                  (Mul x (Apply f (Add x (Neg (IntE 1))))))))
               in eval (Apply factorial (IntE 5)) == 120 -- Note: This is a hypothetical scenario for illustration. Actual implementation of factorial would differ.
  ]

main :: IO ()
main = do
    -- Demonstrate evaluation
    putStrLn "Evaluating expressions:"
    print $ eval (Add (IntE 1) (IntE 2))
    print $ eval (Mul (Neg (IntE 2)) (IntE 3))

    -- Pretty print an expression
    putStrLn "\nPretty printing expressions:"
    putStrLn $ prettyPrint (If (BoolE True) (IntE 1) (IntE 2))

    -- Show length of an expression
    putStrLn "\nLength of the expression:"
    print $ lengthOfExpr (If (BoolE True) (IntE 1) (IntE 2))

    -- Generate Haskell code from an expression
    putStrLn "\nGenerating Haskell code from an expression:"
    generatedCode <- runQ $ codegen (Add (IntE 1) (IntE 2))
    putStrLn $ pprint generatedCode

    -- Running tests
    putStrLn "\nRunning tests:"
    _ <- runTestTT tests
    return ()