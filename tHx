-- A typed expression DSL using phantom types for additional type safety
data SafeExpr a where
    SInt  :: Int -> SafeExpr Int
    SBool :: Bool -> SafeExpr Bool
    SAdd  :: SafeExpr Int -> SafeExpr Int -> SafeExpr Int
    -- Using a phantom type to indicate the operation type
    SMul  :: SafeExpr Int -> SafeExpr Int -> SafeExpr Int
    SEq   :: Eq a => SafeExpr a -> SafeExpr a -> SafeExpr Bool


double :: SafeExpr Int -> SafeExpr Int
double expr = SMul (SInt 2) expr

data Sign = Positive | NonPositive | AnySign deriving (Eq, Show)
data State = TrueState | FalseState | AnyState deriving (Eq, Show)

analyze :: Expr -> Expr
analyze (Const i) = Const i
analyze (Add e1 e2) = Add (analyze e1) (analyze e2)
analyze (Mul e1 e2) = Mul (analyze e1) (analyze e2)

-- A new approach for 'compileAndRunExpr' that clarifies its purpose
compileAndRunExpr :: Expr -> IO ()
compileAndRunExpr expr = do
    let compiledUntyped = compileExpr expr
    putStrLn "Compiled Haskell code (Untyped):"
    print =<< runQ compiledUntyped

    -- Note on Typed Compilation
    putStrLn "\nNote: Compiled Haskell code for Typed expressions is generated at compile time. See source for Template Haskell expressions."



-- Demonstration of evaluating a typed expression
evaluateTypedExpr :: IO ()
evaluateTypedExpr = do
    let expr = AddExpr (LitInt 5) (MulExpr (LitInt 2) (LitInt 3))
    putStrLn $ "Evaluating Typed Expression: " ++ show (eval expr)

-- Demonstration of partial evaluation
partialEvalDemo :: IO ()
partialEvalDemo = do
    let pExpr = PAdd (PInt (Just 3)) (PInt (Just 4))
    putStrLn $ "Partial Evaluation: " ++ show (partialEval pExpr)

