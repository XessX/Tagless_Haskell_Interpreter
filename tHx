data Result a = Success a | Failure String

data Expr = Const Int
          | Add Expr Expr
          | Mul Expr Expr

compileExpr :: Expr -> Q Exp
compileExpr (Const i) = [| i |]
compileExpr (Add e1 e2) = [| $(compileExpr e1) + $(compileExpr e2) |]
compileExpr (Mul e1 e2) = [| $(compileExpr e1) * $(compileExpr e2) |]

compileExprTyped :: Expr -> Q (TExp Int)
compileExprTyped (Const i) = [|| i ||]
compileExprTyped (Add e1 e2) = [|| $$(compileExprTyped e1) + $$(compileExprTyped e2) ||]
compileExprTyped (Mul e1 e2) = [|| $$(compileExprTyped e1) * $$(compileExprTyped e2) ||]


type family Semantics a where
  Semantics Int = Integer
  Semantics Bool = Bool



-- Extending Expr with more constructors and types
data ExprType = TInt | TBool

data TypedExpr a where
    LitInt  :: Int -> TypedExpr Int
    LitBool :: Bool -> TypedExpr Bool
    AddExpr :: TypedExpr Int -> TypedExpr Int -> TypedExpr Int
    MulExpr :: TypedExpr Int -> TypedExpr Int -> TypedExpr Int
    AndExpr :: TypedExpr Bool -> TypedExpr Bool -> TypedExpr Bool
    OrExpr  :: TypedExpr Bool -> TypedExpr Bool -> TypedExpr Bool
    EqExpr  :: Eq a => TypedExpr a -> TypedExpr a -> TypedExpr Bool
    IfExpr  :: TypedExpr Bool -> TypedExpr a -> TypedExpr a -> TypedExpr a


-- Safe conditional function
safeIf :: TypedExpr Bool -> TypedExpr a -> TypedExpr a -> TypedExpr a
safeIf = IfExpr
    
addTypedExpr :: TypedExpr Int -> TypedExpr Int -> TypedExpr Int
addTypedExpr = AddExpr

mulTypedExpr :: TypedExpr Int -> TypedExpr Int -> TypedExpr Int
mulTypedExpr = MulExpr


-- Evaluation function
eval :: TypedExpr a -> a
eval (LitInt i) = i
eval (LitBool b) = b
eval (AddExpr e1 e2) = eval e1 + eval e2
eval (MulExpr e1 e2) = eval e1 * eval e2

-- The Partial data type declaration
data Partial :: Type -> Type where
  PInt  :: Maybe Int -> Partial Int
  PBool :: Maybe Bool -> Partial Bool
  PAdd  :: Partial Int -> Partial Int -> Partial Int
  PMul  :: Partial Int -> Partial Int -> Partial Int
  PEq   :: Eq a => Partial a -> Partial a -> Partial Bool

-- The partialEval function definition
partialEval :: Partial a -> Maybe a
partialEval (PInt (Just i)) = Just i
partialEval (PBool (Just b)) = Just b
partialEval (PAdd pa pb) = do
  a <- partialEval pa
  b <- partialEval pb
  return (a + b)
partialEval (PMul pa pb) = do
  a <- partialEval pa
  b <- partialEval pb
  return (a * b)
partialEval (PEq pa pb) = do
  a <- partialEval pa
  b <- partialEval pb
  Just (a == b)
partialEval _ = Nothing
  


