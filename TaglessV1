-- Expression is defined to include integer operations (neg, add, sub, mult), if then else, lambda expression and apllication and pair and projection:
      

-- To evaluate each expression the following class is defioned:
class ExpSYM repr where
    int :: Int -> repr Int                -- int literal
    bool :: Bool -> repr Bool             -- bool literal
    float :: Float -> repr Float
    add :: repr Int -> repr Int -> repr Int
    neg :: repr Int -> repr Int
    sub :: repr Int -> repr Int -> repr Int
    mul :: repr Int -> repr Int -> repr Int
    leq :: repr Int -> repr Int -> repr Bool
    lt  :: repr Int -> repr Int -> repr Bool
    neq :: repr Int -> repr Int -> repr Bool
    eq  :: repr Int -> repr Int -> repr Bool
    gt  :: repr Int -> repr Int -> repr Bool
    gte :: repr Int -> repr Int -> repr Bool
    if_ :: repr Bool -> repr a -> repr a -> repr a
    lam :: (repr a -> repr b) -> repr (a->b)
    app :: repr (a->b) -> repr a -> repr b
    fix :: (repr a -> repr a) -> repr a
--  getInt :: repr -> Int
--  getDouble :: repr -> Double
    fst_ :: repr a -> repr a -> repr a
    snd_ :: repr a -> repr a -> repr a

newtype R a = R a deriving Show
unR (R x) = x


-- An instance of the ExpSYM class for integer numbers:
instance ExpSYM R where
    int x = R x
    bool b = R b
    float f = R f 
    neg (R f) = R (-f)
    add e1 e2 = R((unR e1) + (unR e2))
    sub e1 e2 = R((unR e1) - (unR e2))
    mul e1 e2 = R((unR e1) * (unR e2))
    leq e1 e2 = R((unR e1) <= (unR e2))
    lt e1 e2 = R((unR e1) < (unR e2))
    neq e1 e2 = R((unR e1) /= (unR e2))
    eq e1 e2 = R((unR e1) == (unR e2))    
    gte e1 e2 = R((unR e1) >= (unR e2))
    gt e1 e2 = R((unR e1) > (unR e2))    
    lam f = R (unR.f.R)
    app e1 e2 = R((unR e1) (unR e2))
    fix f = R(fx(unR.f.R)) where fx f = f (fx f)
    if_ be ex1 ex2 = R(if (unR be) then unR ex1 else unR ex2)
    fst_ e1 e2 = R(unR e1)
    snd_ e1 e2 = R(unR e2)
test1 () = add (int 1) (neg(int 2))
    
compR = unR
